# ============================================================
# G Force Repo Ops — Environment Variables Template
# ============================================================
# DO NOT put real values here. This file is committed to git.
# Real values live in 1Password: op://Private/GForceOps/...
# Load secrets via: source scripts/load_secrets.sh
# ============================================================

# --- LLM Provider Keys ---
# OpenRouter (Hermes 3, Mercury Hermes, + 300+ models)
OPENROUTER_API_KEY=op://Private/GForceOps/openrouter_api_key

# NousResearch Hermes Portal (alternative to OpenRouter)
NOUS_PORTAL_TOKEN=op://Private/GForceOps/nous_portal_token

# Google Gemini (auto-authenticated via Antigravity session, but API key for standalone)
GEMINI_API_KEY=op://Private/GForceOps/gemini_api_key

# Anthropic Claude
ANTHROPIC_API_KEY=op://Private/GForceOps/anthropic_api_key

# OpenAI (GPT-4o for vision tasks)
OPENAI_API_KEY=op://Private/GForceOps/openai_api_key

# xAI Grok (optional)
XAI_API_KEY=op://Private/GForceOps/xai_api_key

# --- GitHub ---
GITHUB_TOKEN=op://Private/GForceOps/github_pat
GITHUB_ORG=connectedagents-ai
GITHUB_DEFAULT_REPO=gforce-repo-ops

# --- OpenClaw Gateway ---
OPENCLAW_WORKSPACE=gforce
OPENCLAW_MODEL_BACKEND=http://localhost:9000/v1  # Points to Multi-LLM Router

# Messaging Platform Tokens (set via openclaw onboard)
# TELEGRAM_BOT_TOKEN=op://Private/GForceOps/telegram_bot_token
# DISCORD_BOT_TOKEN=op://Private/GForceOps/discord_bot_token
# SLACK_BOT_TOKEN=op://Private/GForceOps/slack_bot_token
# WHATSAPP_TOKEN=op://Private/GForceOps/whatsapp_token

# --- Hermes Agent ---
API_SERVER_ENABLED=true
HERMES_API_PORT=8642
HERMES_MODEL=openrouter/nousresearch/hermes-3-llama-3.1-70b

# --- Multi-LLM Router ---
ROUTER_HOST=0.0.0.0
ROUTER_PORT=9000
ROUTER_DEFAULT_MODEL=hermes-3
ROUTER_LOG_LEVEL=INFO

# --- Hardware — Raspberry Pi ---
PI_HOST=192.168.1.XXX          # Set to your Pi's IP (or Tailscale IP)
PI_GRIPPER_PORT=8080
PI_GRIPPER_API_KEY=op://Private/GForceOps/pi_api_key
PI_MAX_FORCE=80                 # Safety: max gripper force (0-100)
TAILSCALE_ENABLED=false         # Set true if using Tailscale VPN

# --- Energy / Power Connection ---
ERCOT_API_KEY=op://Private/GForceOps/ercot_api_key
PC_PLATFORM_URL=https://api.powerconnection.com
PC_API_KEY=op://Private/GForceOps/pc_api_key

# --- Web Dashboard ---
NEXT_PUBLIC_ROUTER_URL=http://localhost:9000
NEXT_PUBLIC_HERMES_URL=http://localhost:8642
NEXT_PUBLIC_PI_URL=http://localhost:8080

# --- System ---
LOG_LEVEL=INFO
ENVIRONMENT=development         # development | staging | production
